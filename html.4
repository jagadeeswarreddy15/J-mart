
<!-- J-Mart Account Button -->
<button id="accountBtn" class="jm-account-btn">
  👤 Login / Sign Up
</button>

<!-- Login and Signup Popup -->
<div id="accountModal" class="jm-modal">
  <div class="jm-card">
    <button type="button" id="closeAccount" class="jm-close">
      &times;
    </button>

    <h2>🛒 J-Mart</h2>
    <p>Your everyday grocery store</p>

    <div class="jm-tabs">
      <button type="button" id="loginTab" class="jm-tab active">
        Login
      </button>
      <button type="button" id="signupTab" class="jm-tab">
        Sign Up
      </button>
    </div>

    <form id="accountForm">
      <div id="nameField" hidden>
        <label for="jmName">Full Name</label>
        <input id="jmName" type="text"
          placeholder="Enter your name" autocomplete="name" />
      </div>

      <label for="jmEmail">Email Address</label>
      <input id="jmEmail" type="email"
        placeholder="Enter your email"
        autocomplete="email" required />

      <label for="jmPassword">Password</label>
      <input id="jmPassword" type="password"
        placeholder="Enter password" minlength="8"
        autocomplete="current-password" required />

      <button type="submit" class="jm-submit" id="submitAccount">
        Login
      </button>
    </form>

    <p id="accountMessage" role="status"></p>
    <button type="button" id="logoutBtn" hidden>
      Logout
    </button>
  </div>
</div>

<style>
  .jm-account-btn {
    position: fixed;
    right: 16px;
    bottom: 18px;
    z-index: 1000;
    padding: 12px 16px;
    background: #16833b;
    color: white;
    border: 0;
    border-radius: 25px;
    cursor: pointer;
    box-shadow: 0 3px 12px #0003;
  }

  .jm-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1001;
    background: #0009;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
  }

  .jm-modal.open {
    display: flex;
  }

  .jm-card {
    position: relative;
    width: 100%;
    max-width: 380px;
    max-height: 90vh;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 26px;
    border-radius: 16px;
    background: white;
    color: #222;
    text-align: center;
  }

  .jm-card h2 {
    color: #16833b;
    margin-bottom: 5px;
  }

  .jm-card label {
    display: block;
    text-align: left;
    margin-top: 14px;
    font-size: 14px;
  }

  .jm-card input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px;
    margin-top: 6px;
    border: 1px solid #ccc;
    border-radius: 7px;
  }

  .jm-tabs {
    display: flex;
    gap: 8px;
    margin: 20px 0;
  }

  .jm-tab {
    flex: 1;
    padding: 10px;
    border: 1px solid #16833b;
    border-radius: 7px;
    background: white;
    color: #16833b;
  }

  .jm-tab.active,
  .jm-submit {
    background: #16833b;
    color: white;
  }

  .jm-submit {
    width: 100%;
    padding: 12px;
    margin-top: 20px;
    border: 0;
    border-radius: 7px;
    cursor: pointer;
  }

  .jm-close {
    position: absolute;
    right: 12px;
    top: 8px;
    border: 0;
    background: transparent;
    font-size: 28px;
    cursor: pointer;
  }

  #accountMessage {
    overflow-wrap: anywhere;
    color: #16833b;
  }
</style>

<script>
(function () {
  const modal = document.getElementById("accountModal");
  const form = document.getElementById("accountForm");
  const nameField = document.getElementById("nameField");
  const nameInput = document.getElementById("jmName");
  const emailInput = document.getElementById("jmEmail");
  const passwordInput = document.getElementById("jmPassword");
  const message = document.getElementById("accountMessage");
  const submitBtn = document.getElementById("submitAccount");
  const logoutBtn = document.getElementById("logoutBtn");
  const loginTab = document.getElementById("loginTab");
  const signupTab = document.getElementById("signupTab");

  let mode = "login";

  function setMode(newMode) {
    mode = newMode;
    const signup = mode === "signup";

    nameField.hidden = !signup;
    nameInput.required = signup;
    passwordInput.autocomplete =
      signup ? "new-password" : "current-password";

    loginTab.classList.toggle("active", !signup);
    signupTab.classList.toggle("active", signup);
    submitBtn.textContent = signup ? "Create Account" : "Login";
    message.textContent = "";
  }

  document.getElementById("accountBtn").onclick = function () {
    modal.classList.add("open");
    message.textContent = "";
  };

  document.getElementById("closeAccount").onclick = function () {
    modal.classList.remove("open");
  };

  modal.addEventListener("click", function (event) {
    if (event.target === modal) {
      modal.classList.remove("open");
    }
  });

  loginTab.onclick = function () {
    setMode("login");
  };

  signupTab.onclick = function () {
    setMode("signup");
  };

  form.addEventListener("submit", function (event) {
    event.preventDefault();

    const email = emailInput.value.trim();
    const name = nameInput.value.trim();

    if (mode === "signup" && !name) {
      message.textContent = "Please enter your name.";
      return;
    }

    if (passwordInput.value.length < 8) {
      message.textContent =
        "Password must contain at least 8 characters.";
      return;
    }

    // Frontend demonstration only: no real authentication.
    message.textContent = mode === "signup"
      ? "Demo sign-up complete, " + name + "! Connect a secure backend for a real account."
      : "Demo login form submitted! Connect a secure backend to verify your account.";

    // Do not store passwords or pretend the user is authenticated.
    passwordInput.value = "";
  });

  logoutBtn.onclick = function () {
    message.textContent = "This demo does not create a login session.";
  };
})();
</script>
</body>
</html>
